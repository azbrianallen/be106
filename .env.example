# training_progress/.env.example

# Local development database (optional if you use SQLite locally)
DATABASE_URL=sqlite:///from_env_dev.db

# Flask / app secrets
SECRET_KEY=change-me-dev-secret
JWT_SECRET=change-me-long-random-secret-key

# Docker Compose PostgreSQL settings
POSTGRES_USER=training_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=training_progress_db

# SQLAlchemy URL for Dockerized app (note host is "db", not "localhost")
DOCKER_DATABASE_URL=postgresql+psycopg://training_user:change-me-strong-password@db:5432/training_progress_db

# Port the web container binds to internally (mapped to host 8000)
PORT=8000 